# Supabase project settings (Project Settings → API)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Base URL used when generating shareable /r/:slug links in the admin panel.
VITE_PUBLIC_BASE_URL=your_production_url

# Display name shown in the header and on published replies.
VITE_CHANNEL_NAME=your_channel_name